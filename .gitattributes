# 确保所有 SQL 迁移文件使用 LF 换行符
backend/migrations/*.sql text eol=lf

# 此迁移已以 CRLF 字节上线；保留已应用校验和，禁止 checkout 自动转换。
backend/migrations/250_openai_cache_write_ttl.sql -text !eol whitespace=trailing-space,space-before-tab,cr-at-eol

# Go 源代码文件
*.go text eol=lf

# 前端 源代码文件
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.vue text eol=lf

# Shell 脚本
*.sh text eol=lf

# YAML/YML 配置文件
*.yaml text eol=lf
*.yml text eol=lf

# nginx / 通用配置文件
*.conf text eol=lf

# Dockerfile
Dockerfile text eol=lf
